  "devDependencies": {
    "@cloudflare/workers-types": "5.20260924.1",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.1",
    "wrangler": "4.139.0",
    "yaml": "2.9.1"
  }
}
